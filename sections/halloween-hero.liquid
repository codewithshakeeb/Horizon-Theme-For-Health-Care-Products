{%- doc -%}
  Renders the Black Friday Hero Banner with embedded VIP Sale static pill.
{%- enddoc -%}

{%- assign current_time = 'now' | date: '%s' | plus: 0 -%}
{%- assign end_time = settings.halloween_end_date | default: '2026-11-30T23:59:59' | date: '%s' | plus: 0 -%}
{%- assign halloween_active = false -%}
{%- if settings.halloween_enabled and current_time <= end_time -%}
  {%- assign halloween_active = true -%}
{%- endif -%}

<section class="hw-hero-banner bfcm-hero-banner" role="region" aria-label="Black Friday Hero Banner">
  <div class="hw-hero-container">
    {%- if halloween_active and section.settings.show_pill -%}
      <div class="hw-hero-static-pill bfcm-hero-pill">
        <span class="hw-pill-icon" aria-hidden="true">✦</span>
        <span class="hw-pill-text">{{ section.settings.badge_text | default: 'BLACK FRIDAY STOREWIDE EVENT • UP TO 70% OFF' }}</span>
      </div>
    {%- endif -%}

    <h1 class="hw-hero-title">{{ section.settings.heading | default: 'Clinical-Grade Pain Relief & Wellness Essentials.' }}</h1>
    <p class="hw-hero-subtitle">{{ section.settings.subheading | default: "Save up to 70% storewide on ergonomic recovery tools. Automatic markdowns applied — plus unlock an exclusive VIP mystery voucher via email." }}</p>

    <div class="hw-hero-actions bfcm-hero-actions">
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hw-hero-cta button bfcm-btn-primary">
        {{ section.settings.button_text | default: 'Shop Up to 70% Off' }} &rarr;
      </a>
      <a href="#bfcm-vip-newsletter" class="button bfcm-btn-secondary" onclick="const nl=document.getElementById('bfcm-vip-newsletter')||document.querySelector('.section-halloween-email-strip');if(nl){event.preventDefault();nl.scrollIntoView({behavior:'smooth'});}">
        Unlock VIP Email Offer
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Halloween Hero Banner",
  "tag": "section",
  "class": "section-halloween-hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_pill",
      "label": "Show Deal Pill",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "BLACK FRIDAY STOREWIDE EVENT • UP TO 70% OFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinical-Grade Pain Relief & Wellness Essentials."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Save up to 70% storewide on ergonomic recovery tools. Automatic markdowns applied — plus unlock an exclusive VIP mystery voucher via email."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Shop Up to 70% Off"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Halloween Hero Banner"
    }
  ]
}
{% endschema %}
