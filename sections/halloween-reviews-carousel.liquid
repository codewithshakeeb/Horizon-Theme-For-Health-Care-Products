{%- assign current_time = 'now' | date: '%s' | plus: 0 -%}
{%- assign end_time = settings.halloween_end_date | default: '2026-11-30T23:59:59' | date: '%s' | plus: 0 -%}
{%- assign halloween_active = false -%}
{%- if settings.halloween_enabled and current_time <= end_time -%}
  {%- assign halloween_active = true -%}
{%- endif -%}

<section class="hw-reviews-section bfcm-reviews-section" id="reviews-carousel-{{ section.id }}" aria-label="Customer Reviews">
  <div class="page-width hw-reviews-inner">
    <!-- Judge.me Backend Reviews Carousel - Zero Demo / Fake Data -->
    <div class="jdgm-carousel-wrapper" data-from-snippet="true" data-auto-install="false">
      <div class="jdgm-carousel-title-and-link">
        <h2 class="jdgm-carousel-title">{{ section.settings.heading | default: 'Real Stories. Life-Changing Relief.' }}</h2>
        <span class="jdgm-all-reviews-rating"></span>
      </div>
      {{ shop.metafields.judgeme.carousel }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews Carousel",
  "tag": "section",
  "class": "section-reviews-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Stories. Life-Changing Relief."
    }
  ],
  "presets": [
    {
      "name": "Reviews Carousel"
    }
  ]
}
{% endschema %}
