{%- assign current_time = 'now' | date: '%s' | plus: 0 -%}
{%- assign end_time = settings.halloween_end_date | default: '2026-11-30T23:59:59' | date: '%s' | plus: 0 -%}
{%- assign halloween_active = false -%}
{%- if settings.halloween_enabled and current_time <= end_time -%}
  {%- assign halloween_active = true -%}
{%- endif -%}

{%- if halloween_active and section.settings.enabled -%}
  <div 
    class="hw-hero-overlay-section bfcm-hero-overlay-section" 
    id="hwHeroOverlay-{{ section.id }}" 
    aria-hidden="true"
  >
    <div class="hw-hero-overlay-wrapper bfcm-hero-overlay-wrapper">
      {%- if section.settings.show_glow -%}
        <!-- Ambient Executive Black Friday Glow & Gold Shimmer -->
        <div class="hw-hero-glow-mist bfcm-hero-glow"></div>
      {%- endif -%}
    </div>

    <script>
      (function() {
        function syncOverlayHeight() {
          const overlay = document.getElementById('hwHeroOverlay-{{ section.id }}');
          if (!overlay || window.getComputedStyle(overlay).display === 'none') return;
          window.requestAnimationFrame(function() {
            const hero = document.querySelector('slideshow-component, .slideshow-section, .hero-section, [id*="slideshow"], #MainContent > .shopify-section:first-child');
            if (hero) {
              const h = hero.offsetHeight;
              if (h > 0) {
                overlay.style.height = h + 'px';
              }
            }
          });
        }
        window.addEventListener('resize', syncOverlayHeight, { passive: true });
        window.addEventListener('load', syncOverlayHeight, { once: true });
      })();
    </script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Halloween Hero Overlay",
  "tag": "section",
  "class": "section-halloween-hero-overlay",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Hero Overlay",
      "default": true
    },
    {
      "type": "header",
      "content": "Atmospheric Visuals"
    },
    {
      "type": "checkbox",
      "id": "show_bats",
      "label": "Show Animated Bats",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cobwebs",
      "label": "Show Corner Spiderwebs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Show Ambient Fog / Mist",
      "default": true
    },
    {
      "type": "header",
      "content": "Seasonal Promo Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Floating Sale Pill Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "✦ BLACK FRIDAY STOREWIDE EVENT • UP TO 70% OFF"
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Badge Link"
    }
  ],
  "presets": [
    {
      "name": "Halloween Hero Overlay"
    }
  ]
}
{% endschema %}
