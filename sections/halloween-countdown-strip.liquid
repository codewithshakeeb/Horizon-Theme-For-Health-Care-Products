{%- assign current_time = 'now' | date: '%s' | plus: 0 -%}
{%- assign end_time = settings.halloween_end_date | default: '2026-11-30T23:59:59' | date: '%s' | plus: 0 -%}
{%- assign halloween_active = false -%}
{%- if settings.halloween_enabled and current_time <= end_time -%}
  {%- assign halloween_active = true -%}
{%- endif -%}

{%- if halloween_active -%}
  <section class="hw-countdown-strip bfcm-countdown-strip" aria-label="Black Friday Sale Countdown" id="hwCountdownStrip-{{ section.id }}">
    <div class="hw-strip-inner">
      <div class="hw-strip-label">
        <span class="hw-strip-icon" aria-hidden="true">✦</span>
        <div class="hw-strip-text-group">
          <span class="hw-strip-main-heading">{{ section.settings.heading | default: 'Black Friday Sale Ends In:' }}</span>
          <span class="hw-strip-subheading">{{ section.settings.subheading | default: 'Up to 70% Off Storewide — No Code Needed' }}</span>
        </div>
      </div>

      <div class="hw-timer-boxes bfcm-timer-boxes" aria-live="off" role="timer" aria-label="Countdown Timer">
        <div class="hw-time-box">
          <strong id="hwDays" class="hw-days">00</strong>
          <span>Days</span>
        </div>
        <div class="hw-timer-colon" aria-hidden="true">:</div>
        <div class="hw-time-box">
          <strong id="hwHours" class="hw-hours">00</strong>
          <span>Hours</span>
        </div>
        <div class="hw-timer-colon" aria-hidden="true">:</div>
        <div class="hw-time-box">
          <strong id="hwMins" class="hw-mins">00</strong>
          <span>Mins</span>
        </div>
        <div class="hw-timer-colon" aria-hidden="true">:</div>
        <div class="hw-time-box">
          <strong id="hwSecs" class="hw-secs">00</strong>
          <span>Secs</span>
        </div>
      </div>

      <div class="bfcm-strip-actions">
        <div class="bfcm-strip-auto-badge">
          <span>✦ A: Subscribers Get an Extra 10% Off First Order</span>
        </div>

        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="hw-strip-cta bfcm-strip-cta">
          <span>{{ section.settings.button_text | default: 'Shop All Deals' }} &rarr;</span>
        </a>

        {% comment %} <a href="#bfcm-vip-newsletter" class="bfcm-strip-vip-link" onclick="const nl=document.getElementById('bfcm-vip-newsletter')||document.querySelector('.section-halloween-email-strip');if(nl){event.preventDefault();nl.scrollIntoView({behavior:'smooth'});}">
          <span>Unlock Extra VIP % Via Email &rarr;</span>
        </a> {% endcomment %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Halloween Countdown Strip",
  "tag": "section",
  "class": "section-halloween-countdown-strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BLACK FRIDAY EVENT ENDS IN"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)",
      "default": "Up to 70% Off Storewide — No Code Needed"
    },
    {
      "type": "header",
      "content": "Call to Action Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Shop All Deals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Halloween Countdown Strip"
    }
  ]
}
{% endschema %}
