{%- assign current_time = 'now' | date: '%s' | plus: 0 -%}
{%- assign end_time = settings.halloween_end_date | default: '2026-11-30T23:59:59' | date: '%s' | plus: 0 -%}
{%- assign halloween_active = false -%}
{%- if settings.halloween_enabled and current_time <= end_time -%}
  {%- assign halloween_active = true -%}
{%- endif -%}

{%- if halloween_active -%}
  <section class="hw-email-strip bfcm-email-strip" id="bfcm-vip-newsletter" aria-labelledby="hwEmailHeading-{{ section.id }}">
    <div class="page-width hw-email-container">
      <div class="hw-email-card">
        <!-- Ambient Decorative Glow -->
        <div class="hw-email-glow" aria-hidden="true"></div>

        <div class="hw-email-content">
          <!-- VIP Tag Pill -->
          <div class="hw-email-badge">
            <span class="hw-email-badge-dot"></span>
            <span class="hw-email-badge-text">VIP Members • Extra 10% Off</span>
          </div>

          <!-- Main Heading -->
          <h2 id="hwEmailHeading-{{ section.id }}" class="hw-email-title">
            {{ section.settings.heading | default: 'Unlock Your Private VIP Pass + 15% Off' }}
          </h2>

          <!-- Subheading -->
          <p class="hw-email-sub">
            {{ section.settings.subheading | default: 'Join 45,000+ wellness members. Get your private discount code delivered instantly, plus early access to doorbuster drops.' }}
          </p>

          <!-- Email Form -->
          {%- form 'customer', id: 'hwEmailStripForm', class: 'hw-email-form', aria-label: 'Subscribe to newsletter', data-tool-name: 'subscribe-newsletter' -%}
            <input type="hidden" name="contact[tags]" value="bfcm-vip-email-subscriber">
            <input type="hidden" name="contact[accepts_marketing]" value="true">

            {%- if form.posted_successfully? -%}
              <div class="hw-email-success-card">
                <span class="hw-success-icon">✓</span>
                <div class="hw-success-text">
                  <strong>You're on the VIP list!</strong>
                  <p>Check your inbox for your private 15% off discount code.</p>
                </div>
              </div>
            {%- else -%}
              <div class="hw-email-input-capsule">
                <div class="hw-input-icon-wrap" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="M22 6L12 13 2 6"></path>
                  </svg>
                </div>
                <input 
                  type="email" 
                  name="contact[email]" 
                  class="hw-email-input" 
                  placeholder="Enter your email for private VIP code..." 
                  required 
                  aria-label="Email address for VIP access"
                  value="{% if customer %}{{ customer.email }}{% endif %}"
                >
                <button type="submit" class="hw-email-submit">
                  <span>{{ section.settings.button_label | default: 'Claim My 15% Off' }}</span>
                  <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </button>
              </div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="hw-email-errors">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {%- endform -%}

          <!-- Micro Trust Elements -->
          <div class="hw-email-micro-trust">
            <span class="hw-micro-item"><span class="hw-micro-icon">🔒</span> Zero spam guarantee</span>
            <span class="hw-micro-sep">•</span>
            <span class="hw-micro-item"><span class="hw-micro-icon">⚡</span> Instant code delivery</span>
            <span class="hw-micro-sep">•</span>
            <span class="hw-micro-item"><span class="hw-micro-icon">✓</span> Unsubscribe anytime with 1 click</span>
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Halloween Email Strip",
  "tag": "section",
  "class": "section-halloween-email-strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Unlock Your Private VIP Pass + 15% Off"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join 45,000+ wellness members. Get your private discount code delivered instantly, plus early access to doorbuster drops."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Claim My 15% Off"
    }
  ],
  "presets": [
    {
      "name": "Halloween Email Strip"
    }
  ]
}
{% endschema %}
