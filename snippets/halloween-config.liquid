{%- comment -%}
  Healtence Black Friday / Cyber Monday (BFCM) & Seasonal Configuration Snippet
  Computes global bfcm_active state and provides visual tokens & runtime configuration.
{%- endcomment -%}
{%- assign current_time = 'now' | date: '%s' | plus: 0 -%}
{%- assign end_time = settings.halloween_end_date | default: '2026-11-30T23:59:59' | date: '%s' | plus: 0 -%}
{%- assign halloween_active = false -%}

{%- if settings.halloween_enabled and current_time <= end_time -%}
  {%- assign halloween_active = true -%}
{%- endif -%}

{%- if halloween_active -%}
  <!-- bfcm:active -->
  <style>
    :root {
      /* Healtence Executive Black Friday Palette */
      --color-bfcm-obsidian: #0D1F12;
      --color-bfcm-forest: #1B4A12;
      --color-bfcm-forest-deep: #13350C;
      --color-bfcm-gold: {{ settings.halloween_accent_color | default: '#F59E0B' }};
      --color-bfcm-gold-bright: #FFB800;
      --color-bfcm-gold-glow: rgba(245, 158, 11, 0.28);
      --color-bfcm-crimson: #E11D48;
      --color-bfcm-crimson-bg: #FFF5F5;
      --color-bfcm-crimson-border: #FDA4AF;
      --color-bfcm-sage-mist: #F4F7F4;
      --color-bfcm-sage: #DCE6DA;
      --color-bfcm-text-muted: #64748B;
      --color-bfcm-card-bg: #FFFFFF;
      --color-bfcm-dark-border: rgba(255, 255, 255, 0.12);

      /* Backward compatibility with legacy .hw-* styles */
      --color-halloween-accent: var(--color-bfcm-gold);
      --color-halloween-glow: var(--color-bfcm-gold-glow);
      --hw-orange: var(--color-bfcm-gold);
      --hw-orange-hover: var(--color-bfcm-gold-bright);
      --hw-green: var(--color-bfcm-forest);
      --hw-dark-green: var(--color-bfcm-obsidian);
      --hw-sage: var(--color-bfcm-sage);
      --hw-card-bg: var(--color-bfcm-card-bg);
    }
  </style>
  <script>
    (function() {
      const config = {
        active: true,
        blackFridayDate: '2026-11-27T23:59:59-05:00',
        cyberMondayDate: '2026-11-30T23:59:59-05:00',
        endDate: {{ settings.halloween_end_date | default: '2026-11-30T23:59:59' | json }},
        discountCode: {{ settings.halloween_discount_code | default: 'BFCM25' | json }},
        discountPercent: 25,
        accentColor: {{ settings.halloween_accent_color | default: '#F59E0B' | json }},
        freeShippingThreshold: 50,
        spinWheelEnabled: false,
        floatingTriggerEnabled: false
      };
      window.BFCM = config;
      window.HALLOWEEN = config; // Full backward compatibility
      window.openHalloweenWheel = function() {};
      window.closeHalloweenWheel = function() {};
    })();
  </script>
{%- else -%}
  <script>
    window.BFCM = { active: false };
    window.HALLOWEEN = { active: false };
  </script>
{%- endif -%}
