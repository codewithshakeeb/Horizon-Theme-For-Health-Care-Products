{%- doc -%}
  Renders responsive breadcrumb navigation for PDP, Collection, and other pages.
  Follows Healtence Horizon Theme design standards.
  (BreadcrumbList JSON-LD is emitted centrally in snippets/bfcm-schema-aeo.liquid.)
{%- enddoc -%}

{%- unless template == 'index' or template.name == 'index' -%}
  {%- assign home_label = 'Home' -%}
  {%- assign collections_label = 'Collections' -%}
  {%- assign products_label = 'Products' -%}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="breadcrumbs__container">
      <ol class="breadcrumbs__list">
        <!-- Home Item -->
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ routes.root_url }}">
            <span>{{ home_label }}</span>
          </a>
        </li>

        {%- case template.name -%}
          {%- when 'collection' -%}
            <li class="breadcrumbs__separator" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </li>
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ routes.collections_url }}">
                <span>{{ collections_label }}</span>
              </a>
            </li>

            {%- if collection.handle -%}
              <li class="breadcrumbs__separator" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </li>
              {%- if current_tags -%}
                <li class="breadcrumbs__item">
                  <a class="breadcrumbs__link" href="{{ collection.url }}">
                    <span>{{ collection.title | escape }}</span>
                  </a>
                </li>
                <li class="breadcrumbs__separator" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </li>
                <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
                  <span class="breadcrumbs__current">{{ current_tags | join: ' + ' }}</span>
                </li>
              {%- else -%}
                <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
                  <span class="breadcrumbs__current">{{ collection.title | escape }}</span>
                </li>
              {%- endif -%}
            {%- endif -%}

          {%- when 'product' -%}
            {%- assign product_collection = collection | default: product.collections.first -%}
            {%- if product_collection -%}
              <li class="breadcrumbs__separator" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </li>
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ product_collection.url }}">
                  <span>{{ product_collection.title | escape }}</span>
                </a>
              </li>
            {%- else -%}
              <li class="breadcrumbs__separator" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </li>
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ routes.all_products_collection_url }}">
                  <span>{{ products_label }}</span>
                </a>
              </li>
            {%- endif -%}

            <li class="breadcrumbs__separator" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </li>
            <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
              <span class="breadcrumbs__current breadcrumbs__current--truncate" title="{{ product.title | escape }}">
                {{ product.title | escape }}
              </span>
            </li>

          {%- when 'blog' -%}
            <li class="breadcrumbs__separator" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </li>
            {%- if current_tags -%}
              <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="{{ blog.url }}">
                  <span>{{ blog.title | escape }}</span>
                </a>
              </li>
              <li class="breadcrumbs__separator" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </li>
              <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
                <span class="breadcrumbs__current">{{ current_tags | join: ' + ' }}</span>
              </li>
            {%- else -%}
              <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
                <span class="breadcrumbs__current">{{ blog.title | escape }}</span>
              </li>
            {%- endif -%}

          {%- when 'article' -%}
            <li class="breadcrumbs__separator" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </li>
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ blog.url }}">
                <span>{{ blog.title | escape }}</span>
              </a>
            </li>
            <li class="breadcrumbs__separator" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </li>
            <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
              <span class="breadcrumbs__current breadcrumbs__current--truncate" title="{{ article.title | escape }}">
                {{ article.title | escape }}
              </span>
            </li>

          {%- when 'page' -%}
            <li class="breadcrumbs__separator" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </li>
            <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
              <span class="breadcrumbs__current">{{ page.title | escape }}</span>
            </li>

          {%- else -%}
            <li class="breadcrumbs__separator" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </li>
            <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
              <span class="breadcrumbs__current">{{ page_title | escape }}</span>
            </li>
        {%- endcase -%}
      </ol>
    </div>
  </nav>
{%- endunless -%}
