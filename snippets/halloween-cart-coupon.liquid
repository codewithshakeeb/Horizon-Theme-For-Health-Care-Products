{%- assign current_time = 'now' | date: '%s' | plus: 0 -%}
{%- assign end_time = settings.halloween_end_date | default: '2026-11-30T23:59:59' | date: '%s' | plus: 0 -%}
{%- assign halloween_active = false -%}
{%- if settings.halloween_enabled and current_time <= end_time -%}
  {%- assign halloween_active = true -%}
{%- endif -%}

{%- if halloween_active -%}
  <div class="hw-cart-coupon-box bfcm-cart-coupon-box" id="hwCartCouponBox">
    <div class="hw-cart-coupon-content">
      <div class="hw-cart-coupon-tag">
        <span class="hw-cart-coupon-icon" aria-hidden="true">✦</span>
        <div class="hw-cart-coupon-text-group">
          <span class="hw-cart-coupon-title">BLACK FRIDAY STOREWIDE EVENT</span>
          <span class="hw-cart-coupon-code" style="letter-spacing: 0.05em; font-size: 11px; text-transform: uppercase;">Up to 70% OFF Applied</span>
        </div>
      </div>
      <div class="bfcm-cart-applied-badge">
        <span>✓ Auto Applied</span>
      </div>
    </div>
    <div class="hw-cart-coupon-note" id="hwCartCouponNote">
      <span>Storewide Black Friday discounts apply automatically at checkout.</span>
    </div>
  </div>
{%- endif -%}
