{%- assign current_time = 'now' | date: '%s' | plus: 0 -%}
{%- assign end_time = settings.halloween_end_date | default: '2026-11-30T23:59:59' | date: '%s' | plus: 0 -%}
{%- assign halloween_active = false -%}
{%- if settings.halloween_enabled and current_time <= end_time -%}
  {%- assign halloween_active = true -%}
{%- endif -%}

{%- if halloween_active -%}
  <div class="hw-cart-banner-wrap bfcm-cart-banner-wrap" id="hwCartBannerWrap"{% if cart.empty? %} style="display: none;"{% endif %}>
    <!-- Free Shipping Banner -->
    <div class="hw-cart-shipping-box">
      <div class="hw-cart-shipping-msg" id="hwCartShippingMsg">
        {%- assign ship_thresh = 5000 -%}
        {%- if cart.total_price >= ship_thresh -%}
          <span><strong>You unlocked Free US Shipping!</strong> &mdash; Ships in 1&ndash;2 business days (5&ndash;10 business days US delivery)</span>
        {%- else -%}
          {%- assign remaining = ship_thresh | minus: cart.total_price -%}
          <span>Add <strong>{{ remaining | money }}</strong> more for <strong>Free US Shipping</strong> ($4.90 flat rate under $50)</span>
        {%- endif -%}
      </div>
      <div class="hw-cart-shipping-track">
        {%- assign fill_pct = cart.total_price | times: 100 | divided_by: ship_thresh -%}
        {%- if fill_pct > 100 -%}{%- assign fill_pct = 100 -%}{%- endif -%}
        <div 
          class="hw-cart-shipping-fill" 
          id="hwCartShippingFill" 
          style="width: {{ fill_pct }}%;"
          data-threshold="50"
        ></div>
        <div class="hw-cart-shipping-goal-icon" aria-hidden="true">🚚</div>
      </div>
    </div>
  </div>
{%- endif -%}
