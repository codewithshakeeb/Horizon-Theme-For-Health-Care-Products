{%- comment -%}
  Mobile Sticky Deal Bar - Redesigned compact docked pill for BFCM
{%- endcomment -%}
{%- assign current_time = 'now' | date: '%s' | plus: 0 -%}
{%- assign end_time = settings.halloween_end_date | default: '2026-11-30T23:59:59' | date: '%s' | plus: 0 -%}
{%- assign halloween_active = false -%}
{%- if settings.halloween_enabled and current_time <= end_time -%}
  {%- assign halloween_active = true -%}
{%- endif -%}

{%- if halloween_active and template.name != 'product' -%}
  <aside class="hw-mobile-sticky-bar hw-bottom-bar bfcm-bottom-bar" id="hwMobileStickyBar" aria-label="Storewide Shipping Notice">
    <div class="timer-box">
      <span class="hw-pumpkin-icon" aria-hidden="true">✦</span>
      <span>Free US shipping on orders over $50</span>
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="cta-link" aria-label="Shop all Healtence pain relief deals">
      Shop All Deals &rarr;
    </a>
  </aside>
{%- endif -%}
